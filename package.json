{
    "name": "env-manager",
    "version": "1.0.0",
    "description": "Keep environment schemas in one .env, generate local values and typed readers, and sync them with AWS Secrets Manager.",
    "type": "module",
    "repository": "github:smirea/env-manager",
    "bin": {
        "env-manager": "./src/cli.ts"
    },
    "files": [
        "src",
        "!src/**/*.test.ts",
        "!src/test-*.ts"
    ],
    "engines": {
        "bun": ">=1.3"
    },
    "scripts": {
        "lint": "oxlint --fix",
        "lint:ci": "oxlint",
        "typecheck": "tsgo --noEmit",
        "test": "bun test",
        "dev": "bun --watch src/cli.ts"
    },
    "dependencies": {
        "@aws-sdk/client-secrets-manager": "^3.980.0",
        "@aws-sdk/client-sts": "^3.980.0",
        "yargs": "^18.0.0",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@types/bun": "^1.3.6",
        "@types/yargs": "^17.0.35",
        "@typescript/native-preview": "^7.0.0-dev.20260127.1",
        "lefthook": "^2.0.16",
        "oxlint": "^1.1.0",
        "typescript": "^5.9.3"
    },
    "packageManager": "bun@1.4.4"
}
