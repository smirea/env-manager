{
	"name": "@stefan.inc/env-manager",
	"version": "1.1.0",
	"description": "Keep environment schemas in one .env, generate local values and typed readers, and sync them with AWS Secrets Manager.",
	"keywords": [
		"aws",
		"cli",
		"dotenv",
		"env",
		"secrets-manager",
		"typescript",
		"xcconfig"
	],
	"homepage": "https://github.com/smirea/env-manager#readme",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/smirea/env-manager.git"
	},
	"bin": {
		"env-manager": "src/cli.ts"
	},
	"files": [
		"src",
		"!src/**/*.test.ts",
		"!src/test-*.ts"
	],
	"type": "module",
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"lint": "oxlint --fix && oxfmt",
		"lint:ci": "oxlint && oxfmt --check",
		"typecheck": "bun check",
		"test": "bun test",
		"dev": "bun --watch src/cli.ts"
	},
	"dependencies": {
		"@aws-sdk/client-secrets-manager": "^3.980.0",
		"@aws-sdk/client-sts": "^3.980.0",
		"yargs": "^18.0.0",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@changesets/cli": "3.0.3",
		"@types/bun": "^1.4.4",
		"@types/yargs": "^17.0.35",
		"lefthook": "^2.2.2",
		"oxfmt": "^0.79.0",
		"oxlint": "^1.94.0"
	},
	"engines": {
		"bun": ">=1.3"
	},
	"packageManager": "bun@1.4.4"
}
